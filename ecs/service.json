{
  "serviceName": "final-submission-backend",
  "cluster": "{{ecs-cluster}}",
  "taskDefinition": "final-submission-backend",
  "desiredCount": 1,
  "launchType": "FARGATE",
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "subnets": ["{{subnet-id}}"],
      "securityGroups": ["{{security-group-id}}"],
      "assignPublicIp": "ENABLED"
    }
  },
  "loadBalancers": [
    {
      "targetGroupArn": "{{target-group-arn}}",
      "containerName": "final-submission-backend",
      "containerPort": 5001
    }
  ],
  "deploymentConfiguration": {
    "maximumPercent": 200,
    "minimumHealthyPercent": 100
  }
}